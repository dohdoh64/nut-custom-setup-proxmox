#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		--prefix=/usr \
		--with-drivers=apc_modbus \
		--with-usb \
		--with-modbus \
		--with-user=nut \
		--with-group=nut \
		--with-doc=no \
		--with-python=no \
		--sysconfdir=/etc/nut

override_dh_installdocs:

override_dh_installchangelogs:

override_dh_installman: